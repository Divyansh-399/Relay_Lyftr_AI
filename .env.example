LLM_API_KEYS=replace-with-first-key,replace-with-second-key
LLM_MODEL=openai/gpt-4o-mini
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
CHAT_REQUESTS_PER_MINUTE=60
CHAT_MAX_CONCURRENT=8
API_BASE_URL=http://localhost:8000
# For a static Vite build or the local Vite dev server:
VITE_API_BASE_URL=http://localhost:8000
# Standalone container listener; defaults are 8000 (backend) and 3000 (frontend).
# PORT=8000
